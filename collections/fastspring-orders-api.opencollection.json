{
  "opencollection": "1.0.0",
  "info": {
    "name": "FastSpring Accounts Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastspring.com/orders"
          },
          "docs": "List orders"
        },
        {
          "info": {
            "name": "Retrieve an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastspring.com/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an order"
        },
        {
          "info": {
            "name": "Update order tags and attributes",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.fastspring.com/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update order tags and attributes"
        }
      ]
    }
  ],
  "bundled": true
}