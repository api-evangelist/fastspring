{
  "opencollection": "1.0.0",
  "info": {
    "name": "FastSpring Accounts Returns API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Returns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a return / refund request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fastspring.com/returns",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a return / refund request"
        },
        {
          "info": {
            "name": "Retrieve a return",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.fastspring.com/returns/:return_id",
            "params": [
              {
                "name": "return_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a return"
        }
      ]
    }
  ],
  "bundled": true
}